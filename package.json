{
  "name": "git-readonly-mcp",
  "version": "1.0.0",
  "description": "Read-only Git inspection tools for MCP clients",
  "type": "module",
  "bin": {
    "git-readonly-mcp": "dist/git-readonly-mcp.mjs"
  },
  "files": [
    "dist/git-readonly-mcp.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude test/integration/**",
    "test:integration": "vitest run test/integration",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "release:archive": "node scripts/package-release.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "git",
    "code-review"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
